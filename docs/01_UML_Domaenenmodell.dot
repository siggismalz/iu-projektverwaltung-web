digraph UML {
 graph [rankdir=TB, bgcolor="white", nodesep=1.1, ranksep=.8, pad=.25];
 node [shape=record, fontname="Arial",fontsize=14, style=filled, fillcolor="#f2f6f7", color="#34495e", penwidth=1.2];
 edge [fontname="Arial",fontsize=12,dir=none,color="#34495e",labeldistance=2.5];
 Tenant [label="{Tenant|- id: Long\l- name: String\l|+ getId(): Long\l+ getName(): String\l}"];
 AppUser [label="{AppUser|- id: Long\l- username: String\l- displayName: String\l- passwordHash: String\l- role: Role\l|+ setRole(role): void\l}"];
 Project [label="{Project|- id: Long\l- name: String\l- description: String\l- archived: boolean\l|+ update(...): void\l}"];
 Task [label="{Task|- id: Long\l- title: String\l- description: String\l- status: TaskStatus\l|+ update(...): void\l}"];

 Tenant -> AppUser [taillabel="1",headlabel="0..*",label="zugeordnet"];
 Tenant -> Project [taillabel="1",headlabel="0..*",label="zugeordnet"];
 AppUser -> Project [taillabel="0..*",headlabel="0..*",label="Mitgliedschaft"];
 Project -> Task [taillabel="1",headlabel="0..*",label="enthält"];
 AppUser -> Task [taillabel="0..1",headlabel="0..*",label="verantwortlich"];
}
